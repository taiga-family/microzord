{
    "name": "remote-standalone-zoneless",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/remote-standalone-zoneless/src",
    "prefix": "microzord",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@nx/angular:webpack-browser",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/remote-standalone-zoneless",
                "index": "apps/remote-standalone-zoneless/src/index.html",
                "main": "apps/remote-standalone-zoneless/src/main.ts",
                "polyfills": "apps/remote-standalone-zoneless/src/polyfills.ts",
                "tsConfig": "apps/remote-standalone-zoneless/tsconfig.app.json",
                "inlineStyleLanguage": "less",
                "assets": [],
                "styles": [],
                "scripts": [],
                "customWebpackConfig": {
                    "path": "apps/remote-standalone-zoneless/webpack.config.js"
                }
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "500kb",
                            "maximumError": "1mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "2kb",
                            "maximumError": "4kb"
                        }
                    ],
                    "fileReplacements": [
                        {
                            "replace": "apps/remote-standalone-zoneless/src/environments/environment.ts",
                            "with": "apps/remote-standalone-zoneless/src/environments/environment.prod.ts"
                        }
                    ],
                    "outputHashing": "all",
                    "customWebpackConfig": {
                        "path": "apps/remote-standalone-zoneless/webpack.prod.config.js"
                    }
                },
                "development": {
                    "buildOptimizer": false,
                    "optimization": false,
                    "vendorChunk": true,
                    "extractLicenses": false,
                    "sourceMap": true,
                    "namedChunks": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "executor": "@nx/angular:webpack-dev-server",
            "configurations": {
                "production": {
                    "buildTarget": "remote-standalone-zoneless:build:production"
                },
                "development": {
                    "buildTarget": "remote-standalone-zoneless:build:development"
                }
            },
            "defaultConfiguration": "development",
            "options": {
                "port": 4205,
                "publicHost": "http://localhost:4205"
            }
        },
        "extract-i18n": {
            "executor": "@angular-devkit/build-angular:extract-i18n",
            "options": {
                "buildTarget": "remote-standalone-zoneless:build"
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/remote-standalone-zoneless"],
            "options": {
                "jestConfig": "apps/remote-standalone-zoneless/jest.config.ts",
                "coverageDirectory": "coverage/remote-standalone-zoneless"
            }
        },
        "serve-static": {
            "executor": "@nx/web:file-server",
            "defaultConfiguration": "production",
            "options": {
                "buildTarget": "remote-standalone-zoneless:build",
                "port": 4205,
                "watch": false
            },
            "configurations": {
                "development": {
                    "buildTarget": "remote-standalone-zoneless:build:development"
                },
                "production": {
                    "buildTarget": "remote-standalone-zoneless:build:production"
                }
            }
        }
    }
}
